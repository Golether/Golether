<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sessions over WebRTC data channels: the signalling of the rendezvous server (shared with the server and the
    browser), the proofs of the device keys, the host that keeps a room and the guest that meets it. The WebRTC itself
    is behind IDataLink: webrtcbin in the applications, a stub in the tests.
  -->
  <PropertyGroup>
    <RootNamespace>Golether.Transports.WebRtc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Golether.Transports.WebRtc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Golether.Transports.Abstractions\Golether.Transports.Abstractions.csproj" />
  </ItemGroup>

</Project>
