<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:embedding="using:Avalonia.Controls.Embedding"
        xmlns:desktop="using:Golether.UI.Controls"
        xmlns:views="using:Golether.Browser.Views">
  <!--
    What a page needs on top of the theme of the desktop application. The film is a <video> of the page under the
    canvas of Avalonia, so the root draws nothing at all: wherever no control paints, the film (or the page behind,
    which has the colour of the background) shows through. The root of the default theme lays a white layer for the
    windows that cannot be transparent, which would hide the film; it is hidden here. The colour is a transparent
    black: the canvas mixes colours already multiplied by their opacity, and a transparent white would come out white.
  -->
  <Style Selector="embedding|EmbeddableControlRoot">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="TransparencyBackgroundFallback" Value="#00000000" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>
  <Style Selector="embedding|EmbeddableControlRoot /template/ Border#PART_TransparencyFallback">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- A line of the event feed or of a notice: the page has no title bar, so the notices sit under the top bar. -->
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!--
    A dialog of the page: a card over a dimmed page, as the dialogs of the desktop are windows over the window. It is
    as wide as the desktop one where the page has room and as wide as the screen less a margin where it has not; the
    veil scrolls it, so on a phone turned on its side the buttons at its bottom stay within reach.
  -->
  <Style Selector="Border.dialogVeil">
    <Setter Property="Background" Value="#B30A0F11" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22,18" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="MaxWidth" Value="460" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.dialog.wide">
    <Setter Property="MaxWidth" Value="560" />
  </Style>
  <Style Selector="views|MainView.compact Border.dialog">
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="DockPanel.inviteCopy > Button">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="views|MainView.compact DockPanel.inviteCopy > Button">
    <Setter Property="DockPanel.Dock" Value="Top" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!--
    The layout follows the size of the page. MainView marks itself: "compact" on a narrow page (a phone held upright),
    "short" on a low one (a phone on its side), "stacked" while the participants lie under the film instead of beside
    it. What a class cannot move (the rows and columns of the session) MainView moves itself.
  -->
  <Style Selector="StackPanel.start">
    <Setter Property="Margin" Value="24,36" />
  </Style>
  <Style Selector="views|MainView.compact StackPanel.start">
    <Setter Property="Margin" Value="16,20" />
  </Style>
  <Style Selector="views|MainView.short StackPanel.start">
    <Setter Property="Margin" Value="24,20" />
  </Style>
  <Style Selector="TextBlock.hero">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="views|MainView.compact TextBlock.hero">
    <Setter Property="FontSize" Value="24" />
  </Style>
  <!-- The space between the two parts of the title, as wide as a space of its letters. -->
  <Style Selector="WrapPanel.hero">
    <Setter Property="ItemSpacing" Value="8" />
  </Style>
  <Style Selector="views|MainView.compact WrapPanel.hero">
    <Setter Property="ItemSpacing" Value="7" />
  </Style>
  <Style Selector="StackPanel.nameRow">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
  </Style>
  <Style Selector="StackPanel.nameRow TextBox">
    <Setter Property="Width" Value="260" />
  </Style>
  <Style Selector="views|MainView.compact StackPanel.nameRow">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="views|MainView.compact StackPanel.nameRow TextBox">
    <Setter Property="Width" Value="NaN" />
  </Style>
  <!--
    The cards of the start screen fill their cells of the grid, so their edges line up with the field of the name. On a
    phone the room inside them is that of the page around them, so their text does not sink much deeper than the title.
  -->
  <Style Selector="views|MainView.compact Border.startCard">
    <Setter Property="Padding" Value="16" />
  </Style>

  <!--
    The bars: thinner on a phone. The top bar keeps the logo at the size of the project page; a narrow one drops the
    title of the session and the words of the lock, whose tip still tells them, and gives the actions all its width.
  -->
  <Style Selector="Border.topBar">
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="views|MainView.short Border.topBar">
    <Setter Property="Padding" Value="16,6" />
  </Style>
  <Style Selector="views|MainView.compact Border.topBar">
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="desktop|OverflowPanel.actions">
    <Setter Property="ReservedWidth" Value="160" />
  </Style>
  <Style Selector="views|MainView.compact desktop|OverflowPanel.actions">
    <Setter Property="ReservedWidth" Value="0" />
  </Style>
  <Style Selector="views|MainView.compact Decorator.sessionCaption, views|MainView.compact TextBlock.secureText">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.playerBar">
    <Setter Property="Padding" Value="16,10,16,12" />
    <Setter Property="BorderThickness" Value="0,1,1,0" />
  </Style>
  <Style Selector="views|MainView.stacked Border.playerBar">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="views|MainView.short Border.playerBar">
    <Setter Property="Padding" Value="16,6,16,8" />
  </Style>
  <Style Selector="views|MainView.compact Border.playerBar">
    <Setter Property="Padding" Value="12,8,12,10" />
  </Style>
  <!-- A phone has no room for the word of the file button, nor for the pen it cannot use anyway. -->
  <Style Selector="views|MainView.compact TextBlock.fileText, views|MainView.compact ToggleButton.appOnly">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- The participants: one column beside the film, two under it. -->
  <Style Selector="ItemsControl.people">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="10" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="views|MainView.stacked ItemsControl.people">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Columns="2" ColumnSpacing="10" RowSpacing="10" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <!--
    The avatar in a tile without a camera. On a phone the tiles under the film are narrow, so the avatar is smaller
    there and rises a little, clear of the name at the bottom of the tile.
  -->
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.avatar TextBlock.initial">
    <Setter Property="FontSize" Value="28" />
  </Style>
  <Style Selector="views|MainView.stacked.compact Border.avatar">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Margin" Value="0,0,0,18" />
  </Style>
  <Style Selector="views|MainView.stacked.compact Border.avatar TextBlock.initial">
    <Setter Property="FontSize" Value="19" />
  </Style>

  <!-- Joining: a smaller logo on a low page, so the code and Cancel fit beside it. -->
  <Style Selector="Image.joinLogo">
    <Setter Property="Width" Value="128" />
    <Setter Property="Height" Value="128" />
  </Style>
  <Style Selector="views|MainView.short Image.joinLogo">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
  </Style>

  <!--
    A feature of the application (the pen) stays on the bar of a page but is plainly out of reach: dimmed, with the
    hint where to find it.
  -->
  <Style Selector="ToggleButton.ghost:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!--
    A flyout whose content is a fixed row always fits: no scroll bar, even where a browser rounds the size of the row
    a pixel up (Firefox did).
  -->
  <Style Selector="FlyoutPresenter.fits">
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!--
    The logo in the top bar is the one of the header of the project page it links to, of the same size: a 30 px
    picture, 10 px apart from 18 px bold letters spaced by 0.3 px. Like there, nothing changes under the pointer.
  -->
  <Style Selector="Button.brand">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.brand:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.brand:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.brand Image">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="0,0,10,0" />
  </Style>
  <Style Selector="Button.brand TextBlock.logo">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.3" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>

  <!-- A reaction is a picture, not a glyph: the canvas of a page has no colour emoji font. -->
  <Style Selector="Image.reaction">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>
</Styles>
