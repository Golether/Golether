<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:Golether.UI.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Golether dark theme: ink ground, tungsten-amber accent (projector lamp), teal for security,
    semantic green / yellow / red for synchronization health.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Golether.Client/Styles/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        A folding block ("Advanced") looks like the text fields around it: the same height, the same border and
        background, the same slightly rounded corners and the same text. Fluent draws it as a tall borderless bar.
      -->
      <x:Double x:Key="ExpanderMinHeight">32</x:Double>
      <Thickness x:Key="ExpanderHeaderPadding">10,0,0,0</Thickness>
      <Thickness x:Key="ExpanderHeaderBorderThickness">1</Thickness>
      <Thickness x:Key="ExpanderContentPadding">12</Thickness>
      <x:Double x:Key="ExpanderChevronButtonSize">24</x:Double>
      <Thickness x:Key="ExpanderChevronMargin">12,0,6,0</Thickness>
      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#66000000" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#66000000" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#66000000" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#99FFFFFF" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="ExpanderContentBackground" Color="#33000000" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#99FFFFFF" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource GoletherBackground}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>

  <!-- Text roles -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoletherMuted}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The heading of a part of a window: a step above the text, below the title of the window. -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.logo">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
  </Style>
  <!--
    A message or a question is two zones: the title on a band of the panel colour with a line under it, and below it,
    on the ground of the window, the text with its answers. The accent mark before the title turns red for an error.
  -->
  <Style Selector="controls|DialogHeader">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{StaticResource GoletherPanel}" BorderBrush="{StaticResource GoletherLine}" BorderThickness="0,0,0,1"
                Padding="22,16">
          <DockPanel>
            <Border Name="PART_Mark" DockPanel.Dock="Left" Width="4" MinHeight="20" CornerRadius="2" Margin="0,3,12,3"
                    Background="{StaticResource GoletherAccent}" />
            <TextBlock Classes="title" VerticalAlignment="Center" TextWrapping="Wrap" Text="{TemplateBinding Title}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|DialogHeader.error /template/ Border#PART_Mark">
    <Setter Property="Background" Value="{StaticResource GoletherBad}" />
  </Style>
  <!-- The answers stay on the ground of the text, so the window does not stripe; only the title has a band. -->
  <Style Selector="Border.dialogFooter">
    <Setter Property="Padding" Value="22,4,22,18" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource GoletherPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="GridSplitter.layout">
    <Setter Property="Background" Value="{StaticResource GoletherLine}" />
    <Setter Property="MinWidth" Value="4" />
  </Style>
  <Style Selector="GridSplitter.layout:pointerover">
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- A tile being dragged to another place, and the tile it would swap with. -->
  <!--
    The carried tile is dimmed by a veil over it. Making the tile itself see-through would not do: opacity is applied
    to every layer of it separately, so the initial under the avatar and the camera picture would show through them.
  -->
  <Style Selector="Border.dragVeil">
    <Setter Property="Background" Value="#A60A0F11" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Panel.dragged > Border.dragVeil">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.tile.dropTarget">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.speakingFrame">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherGood}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="0 0 12 0 #8062C28E" />
  </Style>

  <!-- Chat -->
  <!--
    The chat and the event feed: a card of the panel, lighter than it, as the cards of the start screen are lighter than
    the window. The line under the tabs shows only with the open area.
  -->
  <Style Selector="Border.sideCard">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.sideCardLine">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource GoletherLine}" />
  </Style>
  <!-- The size, frame and fill of the tabs follow the ordinary and ghost buttons further down, which they override. -->
  <Style Selector="Button.tab TextBlock.label">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.tab.selected TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>
  <Style Selector="TextBlock.label.unread">
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="Button.tab.selected TextBlock.label.unread">
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="TextBlock.self">
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="TextBlock.emoji">
    <Setter Property="FontFamily" Value="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif" />
  </Style>
  <Style Selector="Button.reaction">
    <Setter Property="FontFamily" Value="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif" />
    <Setter Property="FontSize" Value="22" />
  </Style>
  <Style Selector="Button.reaction:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.2)" />
  </Style>

  <!-- A reaction rises over the video and fades out (ChatViewModel.ReactionLifetime). -->
  <Style Selector="StackPanel.floatingReaction">
    <Setter Property="Opacity" Value="0" />
    <Style.Animations>
      <Animation Duration="0:0:3" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.6" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.6" />
        </KeyFrame>
        <KeyFrame Cue="12%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="-40" />
          <Setter Property="ScaleTransform.ScaleX" Value="1.1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.1" />
        </KeyFrame>
        <KeyFrame Cue="25%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="70%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-270" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    Toolbar items folded into the "more" button cannot be clicked or focused. Their size and opacity are animated by
    the panel itself (see OverflowPanel.Fold), so they glide out of the row rather than blink away.
  -->
  <Style Selector=":is(Control).overflowed">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Button.overflowed">
    <Setter Property="IsTabStop" Value="False" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.chip.secure">
    <Setter Property="BorderBrush" Value="#734FB3A5" />
    <Setter Property="Background" Value="{StaticResource GoletherSecureTint}" />
  </Style>
  <Style Selector="Border.chip.secure > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GoletherSecure}" />
  </Style>
  <!--
    A state of the session in the top bar. It stands in a row of buttons, so it takes their height (the same padding,
    frame and size of text) and their slightly rounded corners; the filled ground tells it from a button.
  -->
  <Style Selector="Border.status">
    <Setter Property="Background" Value="{StaticResource GoletherPanel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status.secure">
    <Setter Property="BorderBrush" Value="#734FB3A5" />
    <Setter Property="Background" Value="{StaticResource GoletherSecureTint}" />
  </Style>
  <Style Selector="Border.status.secure TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GoletherSecure}" />
  </Style>
  <!--
    The top bar is a row of states and actions, quieter than the buttons of a dialog: everything in it is a step smaller
    (13 px text, 30 px high), and all of it alike, so the states still stand level with the buttons.
  -->
  <Style Selector="Border.topBar Button">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.topBar Border.status">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="11,4" />
  </Style>
  <Style Selector="Border.topBar Border.status TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.topBar Button.square">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- A note over the film, as the phone draws it: a dark pill that the picture shows through a little. -->
  <Style Selector="Border.overFilm">
    <Setter Property="Background" Value="#A60A0F11" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
  </Style>
  <!-- The lamp pulses only while the note is on the screen: an endless animation keeps the window drawing. -->
  <Style Selector="Border.live Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{StaticResource GoletherSecureTint}" />
    <Setter Property="BorderBrush" Value="#734FB3A5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="Border.code > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource GoletherSecure}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#5A4632" />
    <Setter Property="Foreground" Value="#1A1208" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F4BC84" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D98E45" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!--
    The tabs of the chat and the events and their arrow: a frame a step lighter than the card, so they read as buttons
    without standing out, and a fill for the chosen one. Avalonia lets the later style win, not the narrower selector,
    so these come after the ordinary and ghost buttons.
  -->
  <Style Selector="Button.tab">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="BorderBrush" Value="#3A4F56" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Background" Value="{StaticResource GoletherLine}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource GoletherBadTint}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherBad}" />
    <Setter Property="BorderBrush" Value="#66E0685A" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40E0685A" />
    <Setter Property="Foreground" Value="{StaticResource GoletherBad}" />
  </Style>
  <Style Selector="Button.round">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.square">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!--
    Toggle buttons (the pen): the Button.ghost selectors do not apply to ToggleButton, so the released state is
    described separately. It must look exactly like the neighbouring buttons, and the pressed state clearly different.
  -->
  <Style Selector="ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
  </Style>
  <Style Selector="ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPointerOver}" />
  </Style>
  <Style Selector="ToggleButton.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherLine}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoletherAccent}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D98E45" />
    <Setter Property="BorderBrush" Value="#D98E45" />
    <Setter Property="Foreground" Value="{StaticResource GoletherAccentInk}" />
  </Style>
  <Style Selector="ToggleButton.square">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--
    The volume pad in the menu of a participant: the item itself does nothing, so it is not highlighted and does not
    look like a button. Only the speaker and the scale inside it are pressed.
  -->
  <Style Selector="MenuItem.voiceVolume">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="MenuItem.voiceVolume /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem.voiceVolume:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem.voiceVolume:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem.voiceVolume:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Ending the session in a menu looks like its button: red on a red tint. -->
  <Style Selector="MenuItem.danger">
    <Setter Property="Foreground" Value="{StaticResource GoletherBad}" />
  </Style>
  <Style Selector="MenuItem.danger /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource GoletherBadTint}" />
  </Style>
  <Style Selector="MenuItem.danger:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#40E0685A" />
  </Style>
  <Style Selector="MenuItem.danger:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#40E0685A" />
  </Style>
  <Style Selector="Button.mute">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <!--
    The own microphone and camera, over the own tile while the pointer is on it: the tile dims, two large round switches
    come up and grow a little, and the one under the pointer grows a little more. Everything fades away when the pointer
    leaves. A switched-off device is crossed out and dimmer. The layer catches no clicks while it is hidden.
  -->
  <Style Selector="Panel.ownSwitches > Border.shade">
    <Setter Property="Background" Value="#BF0A0F11" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Panel.ownSwitches > StackPanel.switches">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="scale(0.85)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Panel.ownSwitches:pointerover > Border.shade">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Panel.ownSwitches:pointerover > StackPanel.switches">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector="Button.ownSwitch">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#F2162226" />
    <Setter Property="BorderBrush" Value="#4DDDE7E5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ownSwitch /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F2162226" />
    <Setter Property="BorderBrush" Value="#4DDDE7E5" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>
  <Style Selector="Button.ownSwitch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.12)" />
  </Style>
  <Style Selector="Button.ownSwitch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FF223036" />
    <Setter Property="BorderBrush" Value="#99DDE7E5" />
    <Setter Property="Foreground" Value="{StaticResource GoletherText}" />
  </Style>
  <Style Selector="Button.ownSwitch:pressed">
    <Setter Property="RenderTransform" Value="scale(1.04)" />
  </Style>
  <Style Selector="Button.ownSwitch Panel.glyph">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Button.ownSwitch Panel.glyph PathIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ownSwitch Line.strike">
    <Setter Property="Stroke" Value="{StaticResource GoletherText}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.ownSwitch.off Line.strike">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.ownSwitch.off Panel.glyph">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <!-- A folded note over the picture: the pill itself is the button, without a frame of its own. -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.pill /template/ ContentPresenter#PART_ContentPresenter, Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.pill:pointerover Border.overFilm">
    <Setter Property="Background" Value="#E60A0F11" />
  </Style>
  <!-- A second way beside an amber button: only its frame is amber. -->
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource GoletherAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.outline /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource GoletherAccent}" />
  </Style>
  <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="#F4BC84" />
  </Style>
  <Style Selector="Button.outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="#D98E45" />
  </Style>

  <Style Selector="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox.package">
    <Setter Property="FontFamily" Value="{StaticResource GoletherMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="MaxHeight" Value="140" />
  </Style>

  <!-- An invitation shown whole enough to see that a new one is new: three lines instead of the tall package box. -->
  <Style Selector="TextBox.package.invite">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="72" />
  </Style>

  <!-- Timeline -->
  <Style Selector="Slider.timeline">
    <Setter Property="Foreground" Value="{StaticResource GoletherAccent}" />
  </Style>
  <!-- The right part of the track is transparent: the bar with the parts ready to play shows through it. -->
  <Style Selector="Slider.timeline /template/ RepeatButton#PART_IncreaseButton Border#TrackBackground">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
