<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Golether.UI.ViewModels"
             xmlns:client="using:Golether.Client.ViewModels"
             xmlns:clientControls="using:Golether.Client.Controls"
             xmlns:views="using:Golether.UI.Views"
             x:Class="Golether.UI.Views.SessionOverlay"
             x:DataType="vm:MainWindowViewModel">
  <!--
    The reactions and the strokes of the pen over what the screen shows. The window has two of them: one in a window
    of its own above the native video, one inside a picture of a shown folder. A control cannot move between windows
    (each has its own layout), so each stays where it is and only the one in use is visible.
    No fill: the layer must not answer clicks; only the canvas of the pen catches them while the pen is on.
  -->
  <Panel>
    <clientControls:StrokeCanvas x:Name="Strokes" Source="{Binding Drawing}" Aspect="{Binding VideoAspect}"
                                 Zoom="{Binding $parent[views:SessionOverlay].Zoom}" Center="{Binding $parent[views:SessionOverlay].Center}" />
    <!--
      What the start of the film waits for, over the film itself as on the phone: the bar under it has little room,
      least of all under the strip of a shown folder. The lamp pulses only while the note is there.
    -->
    <!-- A little below the edge, so it reads as part of the picture and not of the bar above it. -->
    <Border x:Name="StartNote" Classes="overFilm" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,48,16,0"
            Padding="16,8" IsHitTestVisible="False" Classes.live="{Binding ShowStartNote}" IsVisible="{Binding ShowStartNote}">
      <!-- A dock, not a stack: the text gets what is left of the width and ends with "…" on a narrow film. -->
      <DockPanel>
        <Ellipse DockPanel.Dock="Left" Classes="pulse" Width="9" Height="9" Margin="0,0,10,0" Fill="{StaticResource GoletherAccent}"
                 VerticalAlignment="Center" />
        <TextBlock Classes="mono" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center" MaxWidth="620"
                   TextTrimming="CharacterEllipsis" Text="{Binding CountdownText}" />
      </DockPanel>
    </Border>
    <Border Width="280" Height="360" Background="Transparent" IsHitTestVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
      <ItemsControl ItemsSource="{Binding Chat.Reactions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter" x:DataType="client:FloatingReactionViewModel">
            <Setter Property="Canvas.Right" Value="{Binding Offset}" />
            <Setter Property="Canvas.Bottom" Value="0" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="client:FloatingReactionViewModel">
            <StackPanel Classes="floatingReaction" Width="72" Height="84" Spacing="1">
              <TextBlock Classes="emoji" Text="{Binding Emoji}" FontSize="30" Padding="10,13,10,7" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Background="#A0000000" CornerRadius="5" Padding="4,1" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Sender}" FontSize="10" Foreground="White" MaxWidth="66" TextTrimming="CharacterEllipsis" />
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Panel>
</UserControl>
