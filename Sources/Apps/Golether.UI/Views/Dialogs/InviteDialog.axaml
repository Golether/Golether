<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:Golether.Client.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Golether.UI.ViewModels.Dialogs"
        x:Class="Golether.UI.Views.Dialogs.InviteDialog"
        x:DataType="vm:InviteDialogViewModel"
        Title="{loc:Loc Invite.WindowTitle}"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/golether.ico">
  <!--
    An invitation for the whole company in two forms, each in an area of its own as on the start screen: a link to
    click and a key to paste. What each form is for is said once at its top and does not change; only the short line
    of its validity changes. The answers to the buttons live in the bar at the bottom, in a place kept for them, so
    the window never jumps.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="panel" BorderBrush="{StaticResource GoletherLine}" BorderThickness="0,1,0,0" Padding="22,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Classes="ghost" Content="{loc:Loc Invite.Dialog.NewLink}" Command="{Binding RegenerateCommand}"
                  ToolTip.Tip="{loc:Loc Invite.Dialog.NewLinkTip}" />
          <Button Classes="accent" Content="{loc:Loc Common.Close}" Click="OnClose" IsCancel="True" />
        </StackPanel>
        <!-- Two lines are always kept, so an answer coming or going moves nothing. -->
        <TextBlock x:Name="MessageText" Foreground="{StaticResource GoletherSecure}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Height="32" Text="{Binding Message}" ToolTip.Tip="{Binding Message}" />
      </DockPanel>
    </Border>

    <StackPanel Margin="22,20,22,22" Spacing="14">
      <TextBlock Classes="title" Text="{loc:Loc Invite.WindowTitle}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:Loc Invite.Dialog.Explanation}" />

      <!--
        The link: what most guests need. The field shows several lines on purpose: every link of a session begins the
        same (the address of the page), and what makes a new link new comes only after that.
      -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="heading" Text="{loc:Loc Invite.Dialog.LinkTitle}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Invite.Dialog.LinkText}" />
          <TextBox Classes="package invite" IsReadOnly="True" Text="{Binding Link}" AutomationProperties.Name="{loc:Loc Invite.Dialog.LinkTitle}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="accent" Content="{loc:Loc Invite.Dialog.CopyLink}" Command="{Binding CopyCommand}" />
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                       Text="{loc:Loc Key=Invite.Dialog.LinkExpires, Arg={Binding LinkExpires}}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- The key: the same invitation for those whose link does not open the application. -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="heading" Text="{loc:Loc Invite.Dialog.KeyTitle}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Invite.Dialog.KeyText}" />
          <TextBox Classes="package invite" IsReadOnly="True" Text="{Binding Key}" AutomationProperties.Name="{loc:Loc Invite.Dialog.KeyTitle}" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding Lifetimes}" SelectedItem="{Binding SelectedLifetime}" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Loc Invite.Dialog.LifetimeLabel}" ToolTip.Tip="{loc:Loc Invite.Dialog.LifetimeTip}" />
              <Button Classes="ghost" Content="{loc:Loc Invite.Dialog.CopyKey}" Command="{Binding CopyKeyCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                       Text="{loc:Loc Key=Invite.Dialog.KeyExpires, Arg={Binding KeyExpires}}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Rarely needed: kept out of the way. -->
      <Expander Header="{loc:Loc Invite.Dialog.Advanced}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{loc:Loc Invite.Dialog.ExtraAddressLabel}" />
          <TextBox Text="{Binding ExtraAddress}" PlaceholderText="{loc:Loc Invite.Dialog.ExtraAddressHint}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Invite.Dialog.ExtraAddressNote}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{loc:Loc Key=Invite.Dialog.Addresses, Arg={Binding AddressesText}}" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </DockPanel>
</Window>
