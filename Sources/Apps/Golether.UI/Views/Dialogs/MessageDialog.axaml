<Window xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:Golether.UI.Controls"
        xmlns:loc="using:Golether.Client.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Golether.UI.Views.Dialogs.MessageDialog"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/golether.ico">
  <!--
    A simple message with an OK button, or a question with two answers. An error can be reported from here. The
    title stands on its band; the text and the answers share the ground of the window.
  -->
  <DockPanel>
    <controls:DialogHeader x:Name="Header" DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <Button x:Name="ReportButton" DockPanel.Dock="Left" Classes="ghost" Content="{loc:Loc Problem.ReportShort}"
                ToolTip.Tip="{loc:Loc Problem.ReportTip}" Click="OnReport" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button x:Name="CancelButton" Classes="ghost" Content="{loc:Loc Common.Cancel}" Click="OnCancel" IsCancel="True" IsVisible="False" />
          <Button x:Name="OkButton" Classes="accent" Content="{loc:Loc Common.Understood}" Click="OnOk" IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock x:Name="MessageText" Margin="22,18,22,18" TextWrapping="Wrap" Classes="muted" />
  </DockPanel>
</Window>
